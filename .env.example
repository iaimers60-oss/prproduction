# ─── Site ────────────────────────────────────────────────
# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# ─── Supabase (database, admin login, storage) ───────────
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SERVER ONLY. Used by the payment API routes to read/write payment records.
# Never prefix with NEXT_PUBLIC_ and never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Razorpay (optional online payments) ─────────────────
# Leave empty to keep online checkout disabled. Use test keys (rzp_test_...) first.
RAZORPAY_KEY_ID=
# SERVER ONLY
RAZORPAY_KEY_SECRET=
# SERVER ONLY. Razorpay dashboard → Webhooks → secret you choose
RAZORPAY_WEBHOOK_SECRET=
